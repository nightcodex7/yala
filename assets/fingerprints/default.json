      "icon_hint": "memory"
    },
    {
      "pattern": "^tasmota-",
      "device_type": "smart_plug",
      "icon_hint": "power"
    },
    {
      "pattern": "^shelly",
      "device_type": "smart_relay",
      "icon_hint": "bolt"
    },
    {
      "pattern": "^ring-",
      "device_type": "smart_doorbell",
      "icon_hint": "doorbell"
    },
    {
      "pattern": "^wyze-",
      "device_type": "security_camera",
      "icon_hint": "videocam"
    }
  ]
