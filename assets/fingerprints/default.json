      "device_type": "audio_receiver",
      "icon_hint": "speaker"
    },
    {
      "prefix": "00:11:32",
      "vendor": "Synology",
      "device_type": "nas_storage",
      "icon_hint": "storage"
    },
    {
      "prefix": "00:17:88",
      "vendor": "Philips Hue",
      "device_type": "smart_hub",
      "icon_hint": "lightbulb"
    },
    {
      "prefix": "B8:27:EB",
      "vendor": "Raspberry Pi Foundation",
      "device_type": "single_board_computer",
      "icon_hint": "developer_board"
    },
    {
      "prefix": "DC:A6:32",
      "vendor": "Raspberry Pi Trading",
      "device_type": "single_board_computer",
      "icon_hint": "developer_board"
    },
    {
      "prefix": "E4:5F:01",
      "vendor": "Raspberry Pi Trading",
      "device_type": "single_board_computer",
      "icon_hint": "developer_board"
    }
  ],
  "hostname_rules": [
    {
      "pattern": "^espressif-",
